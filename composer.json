{
    "name": "knocklabs/knockphp",
    "description": "Knock PHP SDK",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Knock",
            "email": "hello@knock.app",
            "homepage": "https://knock.app/"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "league/uri-components": "^7.6",
        "php-http/client-common": "^2.7.2",
        "php-http/discovery": "^1.14",
        "php-http/httplug": "^2.4.1",
        "php-http/promise": "^1.3.1",
        "psr/http-client": "^1.0",
        "psr/http-client-implementation": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-factory-implementation": "^1.0",
        "psr/http-message": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Knock\\KnockSdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "guzzlehttp/psr7": "^2.6",
        "php-http/mock-client": "^1.6.1",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.5"
    }
}
